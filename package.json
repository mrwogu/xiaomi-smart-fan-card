{
  "name": "xiaomi-fan-card",
  "version": "1.1.0",
  "description": "Modern capability-aware Lovelace card for Xiaomi and generic Home Assistant fans.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/mrwogu/xiaomi-smart-fan-card#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrwogu/xiaomi-smart-fan-card.git"
  },
  "bugs": {
    "url": "https://github.com/mrwogu/xiaomi-smart-fan-card/issues"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "xiaomi",
    "fan",
    "smart-home"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "npm run bundle",
    "bundle": "rollup --config",
    "dev": "rollup --config --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md \".github/**/*.md\" \"docs/**/*.md\" package.json package-lock.json hacs.json renovate.json promptscript.yaml rollup.config.mjs release-please-config.json .release-please-manifest.json codecov.yml .github/**/*.yml",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "^20.11.2",
    "prettier": "^3.6.2",
    "rollup": "^4.46.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^4.1.10"
  }
}
